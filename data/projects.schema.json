{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/70b185/Aggregat/schema/projects.schema.json",
  "title": "Aggregat projects (data/projects.yml and data/candidates.yml)",
  "description": "Field meanings are documented at the top of data/projects.yml. scripts/validate.py checks this schema plus cross-references (device slugs, relation targets, unique ids).",
  "type": "object",
  "required": ["checked", "projects"],
  "additionalProperties": false,
  "properties": {
    "checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "projects": {"type": ["array", "null"], "items": {"$ref": "#/$defs/project"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"},
    "tested": {"enum": ["unit", "partly", "emulator", "not-stated"]},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "url": {"type": "string", "pattern": "^https?://\\S+$"},
    "project": {
      "type": "object",
      "required": ["id", "name", "author", "kind", "devices", "status", "notes", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "name": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "kind": {"enum": ["mod", "loader", "emulator", "editor", "tool", "research", "library",
                          "agent-skill", "resource", "request"]},
        "list": {"enum": ["mods", "dev", "musician"]},
        "also_lists": {"type": "array", "items": {"enum": ["mods", "dev", "musician"]}},
        "devices": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
        "repo": {"oneOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
        "links": {"oneOf": [{"type": "object", "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}}, {"type": "null"}]},
        "status": {"enum": ["active", "beta", "alpha", "stable", "wip", "pre-release", "released", "done", "request",
                            "unlabeled", "unknown", "unreachable", "unverified", "dormant", "archived", "inactive"]},
        "base_os": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "last_activity": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "latest_seen": {"type": "string"},
        "notes": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "license": {"type": "string"},
        "tested": {"$ref": "#/$defs/tested"},
        "tested_note": {"type": "string"},
        "install": {"type": "string"},
        "contains": {"type": "string"},
        "relations": {
          "type": "array",
          "items": {
            "type": "object", "required": ["type", "id"], "additionalProperties": false,
            "properties": {
              "type": {"enum": ["fork_of", "copy_of", "port_of", "variant_of", "builds_on", "same_project", "bundles",
                                "describes", "unclear", "mod_for", "uses_tool", "vendors", "cites"]},
              "id": {"type": "string"},
              "evidence": {"type": "string"}
            }
          }
        },
        "own_mods": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name", "what"], "additionalProperties": false,
            "properties": {
              "name": {"type": "string"}, "what": {"type": "string"}, "tested": {"$ref": "#/$defs/tested"},
              "author": {"type": "string"}, "devices": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
              "version": {"type": ["string", "number"]}, "path": {"type": "string"}, "note": {"type": "string"},
              "origin": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
